{
  "name": "corelclone-pro",
  "version": "2.0.0",
  "description": "CorelClone Pro 2026 — Vector Graphics Editor for Windows, Mac and Linux",
  "homepage": "https://4u.ia.br/app/corel/",
  "author": {
    "name": "4u Labs",
    "email": "contato@4u.ia.br"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/4u-Labs/corel.git"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.fourulabs.corelclone",
    "productName": "CorelClone Pro",
    "publish": [
      {
        "provider": "github",
        "owner": "4u-Labs",
        "repo": "corel",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "../corelicon.png",
      "category": "Graphics",
      "maintainer": "contato@4u.ia.br",
      "artifactName": "CorelClone.${ext}"
    },
    "win": {
      "target": ["nsis"],
      "icon": "../corelicon.png",
      "artifactName": "CorelClone-Setup.${ext}"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "../corelicon.png",
      "category": "public.app-category.graphics-design",
      "artifactName": "CorelClone.${ext}"
    }
  }
}
